# =============================================================================
# PromptDev — Environment Variables
# =============================================================================
# The deploy script generates this file automatically:
#   curl -fsSL <raw-url>/deploy.sh | bash
#
# Or copy manually and fill in your secrets:
#   cp .env.example .env
# =============================================================================

# ── Encryption (auto-generated by deploy.sh — do not change after first deploy)
ENCRYPTION_KEY=

# ── Frontend / NextAuth.js ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── GitHub / Copilot SDK ────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Bitbucket Server (optional) ────────────────────────────────────────────
BITBUCKET_URL=
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=

# ── Slack Bot (optional — set up during ./deploy.sh) ────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ── Jira Server (optional) ──────────────────────────────────────────────────
JIRA_URL=
JIRA_USERNAME=
JIRA_TOKEN=

# ── Backend / Database ─────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/promptdev
DB_USERNAME=promptdev
DB_PASSWORD=promptdev
JPA_DDL_AUTO=update
WORKSPACE_BASE_PATH=/tmp/promptdev-workspaces

# ── Logging (optional — set to DEBUG for verbose backend output) ────────────
LOG_LEVEL=INFO

# =============================================================================
# PromptDev — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your secrets:
#   cp .env.example .env
#
# Used by docker-compose.yml and start-all scripts.
# =============================================================================

# ── Encryption (REQUIRED — generate with: openssl rand -hex 32) ─────────────
ENCRYPTION_KEY=

# ── Frontend / NextAuth.js ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── GitHub / Copilot SDK ────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Bitbucket Server (optional) ────────────────────────────────────────────
BITBUCKET_URL=
BITBUCKET_PROJECT_KEY=
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=

# ── Slack Bot (optional — required only with --profile slack) ───────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ── Jira Server (optional) ──────────────────────────────────────────────────
JIRA_URL=
JIRA_USERNAME=
JIRA_TOKEN=

# ── Logging (optional — set to DEBUG for verbose backend output) ────────────
LOG_LEVEL=INFO

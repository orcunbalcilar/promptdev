# =============================================================================
# PromptDev — Git Ignore
# =============================================================================

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml
*.iws
*.ipr

# ── Node.js (frontend, bot, cli) ───────────────────────────────────────────
node_modules/

# ── Next.js (promptdev-ui) ───────────────────────────────────────────
promptdev-ui/.next/
promptdev-ui/out/
promptdev-ui/.vercel
promptdev-ui/next-env.d.ts

# ── TypeScript build output ────────────────────────────────────────────────
promptdev-bot/dist/
promptdev-cli/dist/
*.tsbuildinfo

# ── Testing ─────────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright-cli

# ── Misc ────────────────────────────────────────────────────────────────────
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md

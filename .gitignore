# =============================================================================
# PromptDev — Git Ignore
# =============================================================================

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml
*.iws
*.ipr

# ── Java / Maven (promptdev-backend) ───────────────────────────────────────
promptdev-backend/target/
promptdev-backend/.apt_generated
promptdev-backend/.classpath
promptdev-backend/.factorypath
promptdev-backend/.project
promptdev-backend/.settings
promptdev-backend/.springBeans
promptdev-backend/.sts4-cache

# ── Node.js (frontend, bot, cli) ───────────────────────────────────────────
node_modules/

# ── Next.js (promptdev-frontend) ───────────────────────────────────────────
promptdev-frontend/.next/
promptdev-frontend/out/
promptdev-frontend/.vercel
promptdev-frontend/next-env.d.ts

# ── TypeScript build output ────────────────────────────────────────────────
promptdev-bot/dist/
promptdev-cli/dist/
*.tsbuildinfo

# ── Testing ─────────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright-cli

# ── Misc ────────────────────────────────────────────────────────────────────
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

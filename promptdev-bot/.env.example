# PromptDev Slack Bot — Environment Variables
# Copy this file to .env and fill in your secrets.

# Slack App credentials (Socket Mode)
# See README.md → Slack Bot → Setup for how to obtain these values.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# PromptDev API
PROMPTDEV_API_URL=http://localhost:3000/api

# PromptDev Frontend URL (for model discovery)
PROMPTDEV_FRONTEND_URL=http://localhost:3000
